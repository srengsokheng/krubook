# Production site. Caddy obtains and renews the Let's Encrypt certificates itself.
__DOMAIN__ {
	encode zstd gzip
	reverse_proxy 127.0.0.1:4310
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
	}
}

www.__DOMAIN__ {
	redir https://__DOMAIN__{uri} permanent
}

# Address used before the domain existed. It keeps serving the app until DNS for the domain is
# live, then it should redirect (see README).
__HOST__ {
	encode zstd gzip
	reverse_proxy 127.0.0.1:4310
}

# Plain IP address: send visitors to the domain.
http:// {
	redir https://__DOMAIN__{uri} permanent
}
