#!/usr/bin/env bash
# Wrapper installed as /usr/local/bin/krubook-user: runs the account tool as the app user with the
# production settings. Example: sudo krubook-user add you@example.com "Your Name"
set -euo pipefail
cd /opt/krubook/app
exec sudo -u krubook env NODE_NO_WARNINGS=1 $(grep -v '^#' /etc/krubook/env | xargs) node_modules/.bin/tsx server/user-cli.ts "$@"
